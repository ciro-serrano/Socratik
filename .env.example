# Copiá este archivo como ".env" y completá con tus valores reales.
# El archivo ".env" real NUNCA se sube a GitHub (ya está en .gitignore).

# Puerto local (Render lo asigna solo en producción, esto es para tu compu)
PORT=3000

# Conexión a PostgreSQL (te la da Render cuando creás la base de datos)
DATABASE_URL=postgresql://usuario:password@host:5432/nombre_db

# API key de Gemini (la sacás en https://aistudio.google.com/apikey)
GEMINI_API_KEY=tu_api_key_aca

# URL de la API de Piston (sandbox de ejecución de codigo, es pública y gratis)
PISTON_API_URL=https://emkc.org/api/v2/piston
